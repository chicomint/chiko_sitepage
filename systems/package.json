{
  "name": "chicomint-presence",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../.env server.js",
    "test": "node --test test/*.test.js",
    "migrate": "node --env-file-if-exists=../.env scripts/migrate.js",
    "db": "node scripts/local-db.js",
    "test:drawings": "node --test test/drawings.test.js test/drawing-storage.test.js",
    "verify:migration": "node --env-file-if-exists=../.env scripts/verify-migration.js",
    "verify:local": "node scripts/verify-local-html.js",
    "check": "node scripts/check.js"
  },
  "dependencies": {
    "mongodb": "^7.7.0",
    "pngjs": "^7.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "cheerio": "^1.2.0",
    "mongodb-memory-server": "^11.3.0",
    "playwright": "^1.63.0"
  }
}
