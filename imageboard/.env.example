# This file describes the compatible production backend. Do not commit real values.
NODE_ENV=production
CHIKO_DATA_FORMAT=legacy-v16
MONGODB_URI=
CHIKO_DATABASE=lynxchan_production
PUBLIC_ORIGIN=https://boards.chiko.cc
PORT=3000
ADMIN_SESSION_SECRET=
ABUSE_FINGERPRINT_SECRET=
CHIKO_LEGACY_MEDIA_DIR=/data/legacy-media
CHIKO_MEDIA_DIR=/data/chiko-media
# Fail closed until a verified copy and media have passed migration checks.
CHIKO_WRITES_ENABLED=false
CHIKO_DEPLOYMENT_ROLE=production
CHIKO_MIGRATION_APPROVED=false
# Configure only the exact trusted proxy hop/CIDRs verified in this environment.
TRUST_PROXY=
