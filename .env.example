MONGODB_URI=mongodb://127.0.0.1:27017/chicomint
ADMIN_USERNAME=
# Prefer bcrypt (cost 12); plaintext supported for existing installations.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=
SESSION_SECRET=
NODE_ENV=development
SITE_ORIGIN=http://localhost:3000
PORT=3000
# Optional: database name override, persistent legacy files and proxy configuration.
# MONGODB_DB=chicomint
# DRAWINGS_DIRECTORY=/data/drawings
# DATA_DIRECTORY=/data
# ADMIN_TRUSTED_PROXIES=
# ADMIN_IP_HEADER=x-real-ip

# Comments reuse MongoDB and SESSION_SECRET. Optional pre-moderation:
# COMMENTS_REQUIRE_APPROVAL=true
# COMMENT_TRUSTED_PROXIES=
# COMMENT_IP_HEADER=x-real-ip
